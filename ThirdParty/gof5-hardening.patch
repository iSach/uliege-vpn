 	}
@@ -71,3 +87,23 @@ func main() {
 		fatal(err)
 	}
 }
+
+// Bound input and return fixed errors; never echo authentication material.
+func readSession(reader io.Reader) (string, error) {
+	raw, err := io.ReadAll(io.LimitReader(reader, 4098))
+	if err != nil {
+		return "", fmt.Errorf("cannot read private session input")
+	}
+	if len(raw) > 0 && raw[len(raw)-1] == '\n' {
+		raw = raw[:len(raw)-1]
+	}
+	if len(raw) < 10 || len(raw) > 4096 {
+		return "", fmt.Errorf("invalid private session length")
+	}
+	for _, value := range raw {
+		if value < 33 || value > 126 {
+			return "", fmt.Errorf("invalid private session format")
+		}
+	}
+	return string(raw), nil
+}
diff --git a/cmd/gof5/private_session_test.go b/cmd/gof5/private_session_test.go
new file mode 100644
