diff --git a/pkg/config/private_config_test.go b/pkg/config/private_config_test.go
new file mode 100644
index 0000000..b9b633b
--- /dev/null
+++ b/pkg/config/private_config_test.go
@@ -0,0 +1,26 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+func TestExplicitConfigIgnoresSudoUser(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("SUDO_UID", "99999999")
+	if err := os.WriteFile(filepath.Join(dir, "config.yaml"), []byte("driver: wireguard\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := ReadConfig(false, dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Path != dir || strconv.Itoa(cfg.Uid) != strconv.Itoa(os.Geteuid()) {
+		t.Fatal("wrong config location or owner")
+	}
+	if _, err := ReadConfig(false, "relative"); err == nil {
+		t.Fatal("accepted relative path")
+	}
+}
