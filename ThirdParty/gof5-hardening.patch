--- /dev/null
+++ b/cmd/gof5/private_session_test.go
@@ -0,0 +1,19 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestPrivateSession(t *testing.T) {
+	for _, value := range []string{"", "short", "abcdefghij\nINJECT", strings.Repeat("a", 4097), "abcdefghij\r\n"} {
+		if _, err := readSession(strings.NewReader(value)); err == nil {
+			t.Fatal("accepted invalid session")
+		}
+	}
+	for _, value := range []string{"abcdefghij", "abcdefghij\n", strings.Repeat("b", 4096) + "\n"} {
+		if _, err := readSession(strings.NewReader(value)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
