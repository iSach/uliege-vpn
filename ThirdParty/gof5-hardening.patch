+	if sessionStdin {
+		if opts.SessionID != "" {
+			fatal(fmt.Errorf("session and session-stdin are mutually exclusive"))
+		}
+		var err error
+		opts.SessionID, err = readSession(os.Stdin)
+		if err != nil {
+			fatal(err)
